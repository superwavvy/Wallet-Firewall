# Copy this file to .env.local and fill in your own values

# WalletConnect
NEXT_PUBLIC_WC_PROJECT_ID=your_project_id_here

# RPC Endpoints (Alchemy recommended)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key_here
NEXT_PUBLIC_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key_here

# AI Provider: groq | huggingface | ollama
AI_PROVIDER=groq

# Groq (server-side only)
GROQ_API_KEY=gsk_your_key_here

# Hugging Face (optional)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Ollama (optional, for local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
